# Copy to .env. Existing environment variables take precedence.
ADDR=127.0.0.1:8080
DATA_DIR=data

# Set a shared password before exposing the browser game beyond your computer.
# Room codes are invitations; this password controls creating and joining rooms.
ACCESS_KEY=

# Optional Discord Activity. Invite your friends as App Testers in Discord.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Comma-separated Discord user IDs. Required for Discord login.
DISCORD_ALLOWED_USER_IDS=
# Optional additional browser origin, e.g. https://chartline.example.com
PUBLIC_ORIGIN=

